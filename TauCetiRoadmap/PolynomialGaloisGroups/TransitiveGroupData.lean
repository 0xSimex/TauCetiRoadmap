/-- A list of cycles on `Fin n` as one permutation, the cycles composed in the order given.
A point outside `Fin n` is dropped, which never happens for the data above. -/
def cyclesToPerm {n : ℕ} (cs : List (List ℕ)) : Equiv.Perm (Fin n) :=
  (cs.map fun c =>
    (c.filterMap fun k => if h : k < n then some (⟨k, h⟩ : Fin n) else none).formPerm).prod

/-- **The reference subgroup of the label `nT(j+1)`**, generated by the frozen data above.
Layer 6 proves that each of these is transitive, and Layers 6 and 7 prove their invariants,
so nothing downstream trusts the export beyond the numbering itself. -/
def referenceSubgroup (n : ℕ) (j : TransitiveGroupIndex n) : Subgroup (Equiv.Perm (Fin n)) :=
  Subgroup.closure {g | g ∈ (transitiveGroupGens n j.val).map cyclesToPerm}

